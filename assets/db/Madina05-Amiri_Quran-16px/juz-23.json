{"j":22,"d":[[35,29,442,[{"l":1,"t":"۞ وَمَآ أَنزَلْنَا عَلَىٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندٍ مِّنَ ٱلسَّمَآءِ وَمَا","s":0.901},{"l":2,"t":"كُنَّا مُنزِلِينَ ۝28","s":0.887}]],[35,30,442,[{"l":2,"t":" إِن كَانَتْ إِلَّا صَيْحَةً وَٰحِدَةً فَإِذَا هُمْ خَـٰمِدُونَ","s":0.887},{"l":3,"t":"۝29","s":0.937}]],[35,31,442,[{"l":3,"t":" يَـٰحَسْرَةً عَلَى ٱلْعِبَادِۚ مَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ","s":0.937},{"l":4,"t":"يَسْتَهْزِءُونَ ۝30","s":1.055}]],[35,32,442,[{"l":4,"t":" أَلَمْ يَرَوْا۟ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ","s":1.055},{"l":5,"t":"أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ ۝31","s":0.91}]],[35,33,442,[{"l":5,"t":" وَإِن كُلٌّ لَّمَّا جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ","s":0.91},{"l":6,"t":"۝32","s":0.954}]],[35,34,442,[{"l":6,"t":" وَءَايَةٌ لَّهُمُ ٱلْأَرْضُ ٱلْمَيْتَةُ أَحْيَيْنَـٰهَا وَأَخْرَجْنَا مِنْهَا حَبًّا","s":0.954},{"l":7,"t":"فَمِنْهُ يَأْكُلُونَ ۝33","s":1.181}]],[35,35,442,[{"l":7,"t":" وَجَعَلْنَا فِيهَا جَنَّـٰتٍ مِّن نَّخِيلٍ","s":1.181},{"l":8,"t":"وَأَعْنَـٰبٍ وَفَجَّرْنَا فِيهَا مِنَ ٱلْعُيُونِ ۝34","s":1.021}]],[35,36,442,[{"l":8,"t":" لِيَأْكُلُوا۟ مِن ثَمَرِهِۦ","s":1.021},{"l":9,"t":"وَمَا عَمِلَتْهُ أَيْدِيهِمْۖ أَفَلَا يَشْكُرُونَ ۝35","s":1.105}]],[35,37,442,[{"l":9,"t":" سُبْحَـٰنَ ٱلَّذِى","s":1.105},{"l":10,"t":"خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ","s":1.074},{"l":11,"t":"وَمِمَّا لَا يَعْلَمُونَ ۝36","s":1.096}]],[35,38,442,[{"l":11,"t":" وَءَايَةٌ لَّهُمُ ٱلَّيْلُ نَسْلَخُ مِنْهُ ٱلنَّهَارَ","s":1.096},{"l":12,"t":"فَإِذَا هُم مُّظْلِمُونَ ۝37","s":1.104}]],[35,39,442,[{"l":12,"t":" وَٱلشَّمْسُ تَجْرِى لِمُسْتَقَرٍّ لَّهَاۚ","s":1.104},{"l":13,"t":"ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ ۝38","s":0.995}]],[35,40,442,[{"l":13,"t":" وَٱلْقَمَرَ قَدَّرْنَـٰهُ مَنَازِلَ حَتَّىٰ","s":0.995},{"l":14,"t":"عَادَ كَٱلْعُرْجُونِ ٱلْقَدِيمِ ۝39","s":0.928}]],[35,41,442,[{"l":14,"t":" لَا ٱلشَّمْسُ يَنۢبَغِى لَهَآ أَن تُدْرِكَ","s":0.928},{"l":15,"t":"ٱلْقَمَرَ وَلَا ٱلَّيْلُ سَابِقُ ٱلنَّهَارِۚ وَكُلٌّ فِى فَلَكٍ يَسْبَحُونَ ۝40","s":0.996}]],[35,42,443,[{"l":1,"t":"وَءَايَةٌ لَّهُمْ أَنَّا حَمَلْنَا ذُرِّيَّتَهُمْ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ ۝41","s":0.927}]],[35,43,443,[{"l":1,"t":" وَخَلَقْنَا","s":0.927},{"l":2,"t":"لَهُم مِّن مِّثْلِهِۦ مَا يَرْكَبُونَ ۝42","s":0.896}]],[35,44,443,[{"l":2,"t":" وَإِن نَّشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ","s":0.896},{"l":3,"t":"وَلَا هُمْ يُنقَذُونَ ۝43","s":0.907}]],[35,45,443,[{"l":3,"t":" إِلَّا رَحْمَةً مِّنَّا وَمَتَـٰعًا إِلَىٰ حِينٍ ۝44","s":0.907}]],[35,46,443,[{"l":3,"t":" وَإِذَا","s":0.907},{"l":4,"t":"قِيلَ لَهُمُ ٱتَّقُوا۟ مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ ۝45","s":0.9}]],[35,47,443,[{"l":5,"t":"وَمَا تَأْتِيهِم مِّنْ ءَايَةٍ مِّنْ ءَايَـٰتِ رَبِّهِمْ إِلَّا كَانُوا۟ عَنْهَا مُعْرِضِينَ","s":0.905},{"l":6,"t":"۝46","s":0.952}]],[35,48,443,[{"l":6,"t":" وَإِذَا قِيلَ لَهُمْ أَنفِقُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُوا۟","s":0.952},{"l":7,"t":"لِلَّذِينَ ءَامَنُوٓا۟ أَنُطْعِمُ مَن لَّوْ يَشَآءُ ٱللَّهُ أَطْعَمَهُۥٓ إِنْ أَنتُمْ إِلَّا فِى","s":0.937},{"l":8,"t":"ضَلَـٰلٍ مُّبِينٍ ۝47","s":0.911}]],[35,49,443,[{"l":8,"t":" وَيَقُولُونَ مَتَىٰ هَـٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَـٰدِقِينَ","s":0.911},{"l":9,"t":"۝48","s":0.945}]],[35,50,443,[{"l":9,"t":" مَا يَنظُرُونَ إِلَّا صَيْحَةً وَٰحِدَةً تَأْخُذُهُمْ وَهُمْ يَخِصِّمُونَ","s":0.945},{"l":10,"t":"۝49","s":0.998}]],[35,51,443,[{"l":10,"t":" فَلَا يَسْتَطِيعُونَ تَوْصِيَةً وَلَآ إِلَىٰٓ أَهْلِهِمْ يَرْجِعُونَ ۝50","s":0.998}]],[35,52,443,[{"l":11,"t":"وَنُفِخَ فِى ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلْأَجْدَاثِ إِلَىٰ رَبِّهِمْ يَنسِلُونَ","s":0.932},{"l":12,"t":"۝51","s":0.923}]],[35,53,443,[{"l":12,"t":" قَالُوا۟ يَـٰوَيْلَنَا مَنۢ بَعَثَنَا مِن مَّرْقَدِنَاۜۗ هَـٰذَا مَا وَعَدَ ٱلرَّحْمَـٰنُ","s":0.923},{"l":13,"t":"وَصَدَقَ ٱلْمُرْسَلُونَ ۝52","s":1.252}]],[35,54,443,[{"l":13,"t":" إِن كَانَتْ إِلَّا صَيْحَةً","s":1.252},{"l":14,"t":"وَٰحِدَةً فَإِذَا هُمْ جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ ۝53","s":0.973}]],[35,55,443,[{"l":14,"t":" فَٱلْيَوْمَ لَا تُظْلَمُ","s":0.973},{"l":15,"t":"نَفْسٌ شَيْـًٔا وَلَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ۝54","s":1.138}]],[35,56,444,[{"l":1,"t":"إِنَّ أَصْحَـٰبَ ٱلْجَنَّةِ ٱلْيَوْمَ فِى شُغُلٍ فَـٰكِهُونَ ۝55","s":0.913}]],[35,57,444,[{"l":1,"t":" هُمْ وَأَزْوَٰجُهُمْ","s":0.913},{"l":2,"t":"فِى ظِلَـٰلٍ عَلَى ٱلْأَرَآئِكِ مُتَّكِـُٔونَ ۝56","s":0.967}]],[35,58,444,[{"l":2,"t":" لَهُمْ فِيهَا فَـٰكِهَةٌ وَلَهُم","s":0.967},{"l":3,"t":"مَّا يَدَّعُونَ ۝57","s":0.904}]],[35,59,444,[{"l":3,"t":" سَلَـٰمٌ قَوْلًا مِّن رَّبٍّ رَّحِيمٍ ۝58","s":0.904}]],[35,60,444,[{"l":3,"t":" وَٱمْتَـٰزُوا۟ ٱلْيَوْمَ","s":0.904},{"l":4,"t":"أَيُّهَا ٱلْمُجْرِمُونَ ۝59","s":1.003}]],[35,61,444,[{"l":4,"t":" ۞ أَلَمْ أَعْهَدْ إِلَيْكُمْ يَـٰبَنِىٓ ءَادَمَ أَن لَّا","s":1.003},{"l":5,"t":"تَعْبُدُوا۟ ٱلشَّيْطَـٰنَۖ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ۝60","s":1.0}]],[35,62,444,[{"l":5,"t":" وَأَنِ ٱعْبُدُونِىۚ","s":1.0},{"l":6,"t":"هَـٰذَا صِرَٰطٌ مُّسْتَقِيمٌ ۝61","s":1.0}]],[35,63,444,[{"l":6,"t":" وَلَقَدْ أَضَلَّ مِنكُمْ جِبِلًّا كَثِيرًاۖ","s":1.0},{"l":7,"t":"أَفَلَمْ تَكُونُوا۟ تَعْقِلُونَ ۝62","s":0.974}]],[35,64,444,[{"l":7,"t":" هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى كُنتُمْ تُوعَدُونَ","s":0.974},{"l":8,"t":"۝63","s":1.087}]],[35,65,444,[{"l":8,"t":" ٱصْلَوْهَا ٱلْيَوْمَ بِمَا كُنتُمْ تَكْفُرُونَ ۝64","s":1.087}]],[35,66,444,[{"l":8,"t":" ٱلْيَوْمَ نَخْتِمُ","s":1.087},{"l":9,"t":"عَلَىٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُوا۟","s":1.059},{"l":10,"t":"يَكْسِبُونَ ۝65","s":1.051}]],[35,67,444,[{"l":10,"t":" وَلَوْ نَشَآءُ لَطَمَسْنَا عَلَىٰٓ أَعْيُنِهِمْ فَٱسْتَبَقُوا۟","s":1.051},{"l":11,"t":"ٱلصِّرَٰطَ فَأَنَّىٰ يُبْصِرُونَ ۝66","s":1.14}]],[35,68,444,[{"l":11,"t":" وَلَوْ نَشَآءُ لَمَسَخْنَـٰهُمْ","s":1.14},{"l":12,"t":"عَلَىٰ مَكَانَتِهِمْ فَمَا ٱسْتَطَـٰعُوا۟ مُضِيًّا وَلَا يَرْجِعُونَ","s":1.22},{"l":13,"t":"۝67","s":1.074}]],[35,69,444,[{"l":13,"t":" وَمَن نُّعَمِّرْهُ نُنَكِّسْهُ فِى ٱلْخَلْقِۖ أَفَلَا يَعْقِلُونَ ۝68","s":1.074}]],[35,70,444,[{"l":14,"t":"وَمَا عَلَّمْنَـٰهُ ٱلشِّعْرَ وَمَا يَنۢبَغِى لَهُۥٓۚ إِنْ هُوَ إِلَّا ذِكْرٌ وَقُرْءَانٌ مُّبِينٌ","s":0.92},{"l":15,"t":"۝69","s":0.957}]],[35,71,444,[{"l":15,"t":" لِّيُنذِرَ مَن كَانَ حَيًّا وَيَحِقَّ ٱلْقَوْلُ عَلَى ٱلْكَـٰفِرِينَ ۝70","s":0.957}]],[35,72,445,[{"l":1,"t":"أَوَلَمْ يَرَوْا۟ أَنَّا خَلَقْنَا لَهُم مِّمَّا عَمِلَتْ أَيْدِينَآ أَنْعَـٰمًا فَهُمْ لَهَا","s":1.011},{"l":2,"t":"مَـٰلِكُونَ ۝71","s":0.935}]],[35,73,445,[{"l":2,"t":" وَذَلَّلْنَـٰهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَأْكُلُونَ ۝72","s":0.935}]],[35,74,445,[{"l":3,"t":"وَلَهُمْ فِيهَا مَنَـٰفِعُ وَمَشَارِبُۖ أَفَلَا يَشْكُرُونَ ۝73","s":1.014}]],[35,75,445,[{"l":3,"t":" وَٱتَّخَذُوا۟","s":1.014},{"l":4,"t":"مِن دُونِ ٱللَّهِ ءَالِهَةً لَّعَلَّهُمْ يُنصَرُونَ ۝74","s":1.04}]],[35,76,445,[{"l":4,"t":" لَا يَسْتَطِيعُونَ","s":1.04},{"l":5,"t":"نَصْرَهُمْ وَهُمْ لَهُمْ جُندٌ مُّحْضَرُونَ ۝75","s":1.006}]],[35,77,445,[{"l":5,"t":" فَلَا يَحْزُنكَ قَوْلُهُمْۘ","s":1.006},{"l":6,"t":"إِنَّا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۝76","s":1.004}]],[35,78,445,[{"l":6,"t":" أَوَلَمْ يَرَ ٱلْإِنسَـٰنُ أَنَّا","s":1.004},{"l":7,"t":"خَلَقْنَـٰهُ مِن نُّطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُّبِينٌ ۝77","s":1.002}]],[35,79,445,[{"l":7,"t":" وَضَرَبَ لَنَا","s":1.002},{"l":8,"t":"مَثَلًا وَنَسِىَ خَلْقَهُۥۖ قَالَ مَن يُحْىِ ٱلْعِظَـٰمَ وَهِىَ رَمِيمٌ ۝78","s":0.989}]],[35,80,445,[{"l":9,"t":"قُلْ يُحْيِيهَا ٱلَّذِىٓ أَنشَأَهَآ أَوَّلَ مَرَّةٍۖ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ","s":1.025},{"l":10,"t":"۝79","s":0.993}]],[35,81,445,[{"l":10,"t":" ٱلَّذِى جَعَلَ لَكُم مِّنَ ٱلشَّجَرِ ٱلْأَخْضَرِ نَارًا فَإِذَآ أَنتُم","s":0.993},{"l":11,"t":"مِّنْهُ تُوقِدُونَ ۝80","s":0.956}]],[35,82,445,[{"l":11,"t":" أَوَلَيْسَ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","s":0.956},{"l":12,"t":"بِقَـٰدِرٍ عَلَىٰٓ أَن يَخْلُقَ مِثْلَهُمۚ بَلَىٰ وَهُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ ۝81","s":1.029}]],[35,83,445,[{"l":13,"t":"إِنَّمَآ أَمْرُهُۥٓ إِذَآ أ