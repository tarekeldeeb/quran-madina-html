َـٰبِهًا مَّثَانِىَ تَقْشَعِرُّ مِنْهُ","s":0.974},{"l":4,"t":"جُلُودُ ٱلَّذِينَ يَخْشَوْنَ رَبَّهُمْ ثُمَّ تَلِينُ جُلُودُهُمْ وَقُلُوبُهُمْ","s":1.071},{"l":5,"t":"إِلَىٰ ذِكْرِ ٱللَّهِۚ ذَٰلِكَ هُدَى ٱللَّهِ يَهْدِى بِهِۦ مَن يَشَآءُۚ وَمَن","s":1.017},{"l":6,"t":"يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍ ۝23","s":1.0}]],[38,25,461,[{"l":6,"t":" أَفَمَن يَتَّقِى بِوَجْهِهِۦ سُوٓءَ","s":1.0},{"l":7,"t":"ٱلْعَذَابِ يَوْمَ ٱلْقِيَـٰمَةِۚ وَقِيلَ لِلظَّـٰلِمِينَ ذُوقُوا۟ مَا كُنتُمْ تَكْسِبُونَ","s":0.922},{"l":8,"t":"۝24","s":0.989}]],[38,26,461,[{"l":8,"t":" كَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْ فَأَتَىٰهُمُ ٱلْعَذَابُ مِنْ حَيْثُ","s":0.989},{"l":9,"t":"لَا يَشْعُرُونَ ۝25","s":0.888}]],[38,27,461,[{"l":9,"t":" فَأَذَاقَهُمُ ٱللَّهُ ٱلْخِزْىَ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَلَعَذَابُ","s":0.888},{"l":10,"t":"ٱلْـَٔاخِرَةِ أَكْبَرُۚ لَوْ كَانُوا۟ يَعْلَمُونَ ۝26","s":0.981}]],[38,28,461,[{"l":10,"t":" وَلَقَدْ ضَرَبْنَا لِلنَّاسِ فِى","s":0.981},{"l":11,"t":"هَـٰذَا ٱلْقُرْءَانِ مِن كُلِّ مَثَلٍ لَّعَلَّهُمْ يَتَذَكَّرُونَ ۝27","s":0.908}]],[38,29,461,[{"l":11,"t":" قُرْءَانًا عَرَبِيًّا","s":0.908},{"l":12,"t":"غَيْرَ ذِى عِوَجٍ لَّعَلَّهُمْ يَتَّقُونَ ۝28","s":0.932}]],[38,30,461,[{"l":12,"t":" ضَرَبَ ٱللَّهُ مَثَلًا رَّجُلًا فِيهِ","s":0.932},{"l":13,"t":"شُرَكَآءُ مُتَشَـٰكِسُونَ وَرَجُلًا سَلَمًا لِّرَجُلٍ هَلْ يَسْتَوِيَانِ مَثَلًاۚ","s":0.948},{"l":14,"t":"ٱلْحَمْدُ لِلَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ۝29","s":0.901}]],[38,31,461,[{"l":14,"t":" إِنَّكَ مَيِّتٌ وَإِنَّهُم مَّيِّتُونَ","s":0.901},{"l":15,"t":"۝30","s":1.07}]],[38,32,461,[{"l":15,"t":" ثُمَّ إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ عِندَ رَبِّكُمْ تَخْتَصِمُونَ ۝31","s":1.07}]]]}