ْأَحْزَابِ ۝11","s":0.926}]],[37,13,453,[{"l":11,"t":" كَذَّبَتْ قَبْلَهُمْ قَوْمُ","s":0.926},{"l":12,"t":"نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو ٱلْأَوْتَادِ ۝12","s":0.88}]],[37,14,453,[{"l":12,"t":" وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَـٰبُ","s":0.88},{"l":13,"t":"لْـَٔيْكَةِۚ أُو۟لَـٰٓئِكَ ٱلْأَحْزَابُ ۝13","s":0.998}]],[37,15,453,[{"l":13,"t":" إِن كُلٌّ إِلَّا كَذَّبَ ٱلرُّسُلَ","s":0.998},{"l":14,"t":"فَحَقَّ عِقَابِ ۝14","s":0.949}]],[37,16,453,[{"l":14,"t":" وَمَا يَنظُرُ هَـٰٓؤُلَآءِ إِلَّا صَيْحَةً وَٰحِدَةً مَّا لَهَا","s":0.949},{"l":15,"t":"مِن فَوَاقٍ ۝15","s":0.887}]],[37,17,453,[{"l":15,"t":" وَقَالُوا۟ رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَبْلَ يَوْمِ ٱلْحِسَابِ ۝16","s":0.887}]],[37,18,454,[{"l":1,"t":"ٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱذْكُرْ عَبْدَنَا دَاوُۥدَ ذَا ٱلْأَيْدِۖ إِنَّهُۥٓ أَوَّابٌ ۝17","s":0.847}]],[37,19,454,[{"l":2,"t":"إِنَّا سَخَّرْنَا ٱلْجِبَالَ مَعَهُۥ يُسَبِّحْنَ بِٱلْعَشِىِّ وَٱلْإِشْرَاقِ ۝18","s":0.912}]],[37,20,454,[{"l":2,"t":" وَٱلطَّيْرَ","s":0.912},{"l":3,"t":"مَحْشُورَةًۖ كُلٌّ لَّهُۥٓ أَوَّابٌ ۝19","s":0.937}]],[37,21,454,[{"l":3,"t":" وَشَدَدْنَا مُلْكَهُۥ وَءَاتَيْنَـٰهُ ٱلْحِكْمَةَ","s":0.937},{"l":4,"t":"وَفَصْلَ ٱلْخِطَابِ ۝20","s":0.946}]],[37,22,454,[{"l":4,"t":" ۞ وَهَلْ أَتَىٰكَ نَبَؤُا۟ ٱلْخَصْمِ إِذْ تَسَوَّرُوا۟","s":0.946},{"l":5,"t":"ٱلْمِحْرَابَ ۝21","s":0.918}]],[37,23,454,[{"l":5,"t":" إِذْ دَخَلُوا۟ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنْهُمْۖ قَالُوا۟ لَا تَخَفْۖ","s":0.918},{"l":6,"t":"خَصْمَانِ بَغَىٰ بَعْضُنَا عَلَىٰ بَعْضٍ فَٱحْكُم بَيْنَنَا بِٱلْحَقِّ وَلَا تُشْطِطْ","s":0.885},{"l":7,"t":"وَٱهْدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ ۝22","s":0.815}]],[37,24,454,[{"l":7,"t":" إِنَّ هَـٰذَآ أَخِى لَهُۥ تِسْعٌ وَتِسْعُونَ نَعْجَةً","s":0.815},{"l":8,"t":"وَلِىَ نَعْجَةٌ وَٰحِدَةٌ فَقَالَ أَكْفِلْنِيهَا وَعَزَّنِى فِى ٱلْخِطَابِ ۝23","s":0.903}]],[37,25,454,[{"l":8,"t":" قَالَ","s":0.903},{"l":9,"t":"لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرًا مِّنَ ٱلْخُلَطَآءِ لَيَبْغِى","s":0.809},{"l":10,"t":"بَعْضُهُمْ عَلَىٰ بَعْضٍ إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَقَلِيلٌ","s":0.909},{"l":11,"t":"مَّا هُمْۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّـٰهُ فَٱسْتَغْفَرَ رَبَّهُۥ وَخَرَّ رَاكِعًا وَأَنَابَ","s":0.863},{"l":12,"t":"۩ ۝24","s":0.922}]],[37,26,454,[{"l":12,"t":" فَغَفَرْنَا لَهُۥ ذَٰلِكَۖ وَإِنَّ لَهُۥ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍ","s":0.922},{"l":13,"t":"۝25","s":0.873}]],[37,27,454,[{"l":13,"t":" يَـٰدَاوُۥدُ إِنَّا جَعَلْنَـٰكَ خَلِيفَةً فِى ٱلْأَرْضِ فَٱحْكُم بَيْنَ ٱلنَّاسِ","s":0.873},{"l":14,"t":"بِٱلْحَقِّ وَلَا تَتَّبِعِ ٱلْهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ","s":0.857},{"l":15,"t":"عَن سَبِيلِ ٱللَّهِ لَهُمْ عَذَابٌ شَدِيدٌۢ بِمَا نَسُوا۟ يَوْمَ ٱلْحِسَابِ ۝26","s":0.925}]],[37,28,455,[{"l":1,"t":"وَمَا خَلَقْنَا ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا بَـٰطِلًاۚ ذَٰلِكَ ظَنُّ ٱلَّذِينَ كَفَرُوا۟ۚ","s":0.793},{"l":2,"t":"فَوَيْلٌ لِّلَّذِينَ كَفَرُوا۟ مِنَ ٱلنَّارِ ۝27","s":0.882}]],[37,29,455,[{"l":2,"t":" أَمْ نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","s":0.882},{"l":3,"t":"ٱلصَّـٰلِحَـٰتِ كَٱلْمُفْسِدِينَ فِى ٱلْأَرْضِ أَمْ نَجْعَلُ ٱلْمُتَّقِينَ كَٱلْفُجَّارِ","s":0.867},{"l":4,"t":"۝28","s":0.915}]],[37,30,455,[{"l":4,"t":" كِتَـٰبٌ أَنزَلْنَـٰهُ إِلَيْكَ مُبَـٰرَكٌ لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟","s":0.915},{"l":5,"t":"ٱلْأَلْبَـٰبِ ۝29","s":0.95}]],[37,31,455,[{"l":5,"t":" وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَـٰنَۚ نِعْمَ ٱلْعَبْدُۖ إِنَّهُۥٓ أَوَّابٌ","s":0.95},{"l":6,"t":"۝30","s":0.904}]],[37,32,455,[{"l":6,"t":" إِذْ عُرِضَ عَلَيْهِ بِٱلْعَشِىِّ ٱلصَّـٰفِنَـٰتُ ٱلْجِيَادُ ۝31","s":0.904}]],[37,33,455,[{"l":6,"t":" فَقَالَ إِنِّىٓ","s":0.904},{"l":7,"t":"أَحْبَبْتُ حُبَّ ٱلْخَيْرِ عَن ذِكْرِ رَبِّى حَتَّىٰ تَوَارَتْ بِٱلْحِجَابِ ۝32","s":0.913}]],[37,34,455,[{"l":8,"t":"رُدُّوهَا عَلَىَّۖ فَطَفِقَ مَسْحًۢا بِٱلسُّوقِ وَٱلْأَعْنَاقِ ۝33","s":0.949}]],[37,35,455,[{"l":8,"t":" وَلَقَدْ فَتَنَّا","s":0.949},{"l":9,"t":"سُلَيْمَـٰنَ وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِ