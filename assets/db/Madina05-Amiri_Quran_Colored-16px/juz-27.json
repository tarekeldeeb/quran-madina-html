ٰتِ وَٱلْأَرْضِ ۚ وَإِلَى ٱللَّهِ تُرْجَعُ ٱلْأُمُورُ","s":1.047},{"l":5,"t":"۝5","s":1.097}]],[56,7,538,[{"l":5,"t":" يُولِجُ ٱلَّيْلَ فِى ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِى ٱلَّيْلِ ۚ وَهُوَ عَلِيمٌۢ بِذَاتِ","s":1.097},{"l":6,"t":"ٱلصُّدُورِ ۝6","s":1.262}]],[56,8,538,[{"l":6,"t":" ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَأَنفِقُوا۟ مِمَّا جَعَلَكُم","s":1.262},{"l":7,"t":"مُّسْتَخْلَفِينَ فِيهِ ۖ فَٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَأَنفَقُوا۟ لَهُمْ أَجْرٌ كَبِيرٌ ۝7","s":1.06}]],[56,9,538,[{"l":8,"t":"وَمَا لَكُمْ لَا تُؤْمِنُونَ بِٱللَّهِ ۙ وَٱلرَّسُولُ يَدْعُوكُمْ لِتُؤْمِنُوا۟ بِرَبِّكُمْ وَقَدْ","s":1.078},{"l":9,"t":"أَخَذَ مِيثَـٰقَكُمْ إِن كُنتُم مُّؤْمِنِينَ ۝8","s":1.078}]],[56,10,538,[{"l":9,"t":" هُوَ ٱلَّذِى يُنَزِّلُ عَلَىٰ عَبْدِهِۦٓ","s":1.078},{"l":10,"t":"ءَايَـٰتٍۭ بَيِّنَـٰتٍ لِّيُخْرِجَكُم مِّنَ ٱلظُّلُمَـٰتِ إِلَى ٱلنُّورِ ۚ وَإِنَّ ٱللَّهَ بِكُمْ","s":1.098},{"l":11,"t":"لَرَءُوفٌ رَّحِيمٌ ۝9","s":1.045}]],[56,11,538,[{"l":11,"t":" وَمَا لَكُمْ أَلَّا تُنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ وَلِلَّهِ مِيرَٰثُ","s":1.045},{"l":12,"t":"ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ لَا يَسْتَوِى مِنكُم مَّنْ أَنفَقَ مِن قَبْلِ ٱلْفَتْحِ","s":1.075},{"l":13,"t":"وَقَـٰتَلَ ۚ أُو۟لَـٰٓئِكَ أَعْظَمُ دَرَجَةً مِّنَ ٱلَّذِينَ أَنفَقُوا۟ مِنۢ بَعْدُ وَقَـٰتَلُوا۟ ۚ","s":1.066},{"l":14,"t":"وَكُلًّا وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ۝10","s":1.171}]],[56,12,538,[{"l":14,"t":" مَّن ذَا","s":1.171},{"l":15,"t":"ٱلَّذِى يُقْرِضُ ٱللَّهَ قَرْضًا حَسَنًا فَيُضَـٰعِفَهُۥ لَهُۥ وَلَهُۥٓ أَجْرٌ كَرِيمٌ ۝11","s":1.042}]],[56,13,539,[{"l":1,"t":"يَوْمَ تَرَى ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ يَسْعَىٰ نُورُهُم بَيْنَ أَيْدِيهِمْ وَبِأَيْمَـٰنِهِم","s":1.032},{"l":2,"t":"بُشْرَىٰكُمُ ٱلْيَوْمَ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ ذَٰلِكَ","s":1.05},{"l":3,"t":"هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ۝12","s":1.111}]],[56,14,539,[{"l":3,"t":" يَوْمَ يَقُولُ ٱلْمُنَـٰفِقُونَ وَٱلْمُنَـٰفِقَـٰتُ لِلَّذِينَ","s":1.111},{"l":4,"t":"ءَامَنُوا۟ ٱنظُرُونَا نَقْتَبِسْ مِن نُّورِكُمْ قِيلَ ٱرْجِعُوا۟ وَرَآءَكُمْ فَٱلْتَمِسُوا۟ نُورًا","s":0.954},{"l":5,"t":"فَضُرِبَ بَيْنَهُم بِسُورٍ لَّهُۥ بَابٌۢ بَاطِنُهُۥ فِيهِ ٱلرَّحْمَةُ وَظَـٰهِرُهُۥ مِن قِبَلِهِ","s":1.036},{"l":6,"t":"ٱلْعَذَابُ ۝13","s":1.068}]],[56,15,539,[{"l":6,"t":" يُنَادُونَهُمْ أَلَمْ نَكُن مَّعَكُمْ ۖ قَالُوا۟ بَلَىٰ وَلَـٰكِنَّكُمْ فَتَنتُمْ","s":1.068},{"l":7,"t":"أَنفُسَكُمْ وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ وَغَرَّتْكُمُ ٱلْأَمَانِىُّ حَتَّىٰ جَآءَ أَمْرُ","s":1.172},{"l":8,"t":"ٱللَّهِ وَغَرَّكُم بِٱللَّهِ ٱلْغَرُورُ ۝14","s":1.132}]],[56,16,539,[{"l":8,"t":" فَٱلْيَوْمَ لَا يُؤْخَذُ مِنكُمْ فِدْيَةٌ وَلَا","s":1.132},{"l":9,"t":"مِنَ ٱلَّذِينَ كَفَرُوا۟ ۚ مَأْوَىٰكُمُ ٱلنَّارُ ۖ هِىَ مَوْلَىٰكُمْ ۖ وَبِئْسَ ٱلْمَصِيرُ","s":1.103},{"l":10,"t":"۝15","s":1.219}]],[56,17,539,[{"l":10,"t":" ۞ أَلَمْ يَأْنِ لِلَّذِينَ ءَامَنُوٓا۟ أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ ٱللَّهِ","s":1.219},{"l":11,"t":"وَمَا نَزَلَ مِنَ ٱلْحَقِّ وَلَا يَكُونُوا۟ كَٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ مِن قَبْلُ","s":1.091},{"l":12,"t":"فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ ۝16","s":1.106}]],[56,18,539,[{"l":13,"t":"ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ يُحْىِ ٱلْأَرْضَ بَعْدَ مَوْتِهَا ۚ قَدْ بَيَّنَّا لَكُمُ ٱلْـَٔايَـٰتِ","s":1.132},{"l":14,"t":"لَعَلَّكُمْ تَعْقِلُونَ ۝17","s":1.192}]],[56,19,539,[{"l":14,"t":" إِنَّ ٱلْمُصَّدِّقِينَ وَٱلْمُصَّدِّقَـٰتِ وَأَقْرَضُوا۟","s":1.192},{"l":15,"t":"ٱللَّهَ قَرْضًا حَسَنًا يُضَـٰعَفُ لَهُمْ وَلَهُمْ أَجْرٌ كَرِيمٌ ۝18","s":1.327}]],[56,20,540,[{"l":1,"t":"وَٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦٓ أُو۟لَـٰٓئِكَ هُمُ ٱلصِّدِّيقُونَ ۖ وَٱلشُّهَدَآءُ","s":1.098},{"l":2,"t":"عِندَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْ ۖ وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟","s":1.231},{"l":3,"t":"بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَحِيمِ ۝19","s":1.329}]],[56,21,540,[{"l":3,"t":" ٱعْلَمُوٓا۟ أَنَّمَا ٱلْحَيَوٰةُ","s":1.329},{"l":4,"t":"ٱلدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌ فِى ٱلْأَمْوَٰلِ","s":1.219},{"l":5,"t":"وَٱلْأَوْلَـٰدِ ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ","s":1.186},{"l":6,"t":"مُصْفَرًّا ثُمَّ يَكُونُ حُطَـٰمًا ۖ وَفِى ٱلْـَٔاخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ","s":1.119},{"l":7,"t":"مِّنَ ٱللَّهِ وَرِضْوَٰنٌ ۚ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَـٰعُ ٱلْغُرُورِ ۝20","s":1.191}]],[56,22,540,[{"l":8,"t":"سَابِقُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ ٱلسَّمَآءِ","s":1.123},{"l":9,"t":"وَٱلْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ ۚ ذَٰلِكَ فَضْلُ","s":1.182},{"l":10,"t":"ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ۝21","s":1.131}]],[56,23,540,[{"l":10,"t":" مَآ أَصَابَ","s":1.131},{"l":11,"t":"مِن مُّصِيبَةٍ فِى ٱلْأَرْضِ وَلَا فِىٓ أَنفُسِكُمْ إِلَّا فِى كِتَـٰبٍ","s":1.238},{"l":12,"t":"مِّن قَبْلِ أَن نَّبْرَأَهَآ ۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ ۝22","s":1.276}]],[56,24,540,[{"l":12,"t":" لِّكَيْلَا","s":1.276},{"l":13,"t":"تَأْسَوْا۟ عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا۟ بِمَآ ءَاتَىٰكُمْ ۗ وَٱللَّهُ","s":1.359},{"l":14,"t":"لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ ۝23","s":1.242}]],[56,25,540,[{"l":14,"t":" ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ","s":1.242},{"l":15,"t":"ٱلنَّاسَ بِٱلْبُخْلِ ۗ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ ۝24","s":1.178}]],[56,26,541,[{"l":1,"t":"لَقَدْ أَرْسَلْنَا رُسُلَنَا بِٱلْبَيِّنَـٰتِ وَأَنزَلْنَا مَعَهُمُ ٱلْكِتَـٰبَ","s":1.363},{"l":2,"t":"وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِ ۖ وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ","s":1.343},{"l":3,"t":"بَأْسٌ شَدِيدٌ وَمَنَـٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ","s":1.125},{"l":4,"t":"بِٱلْغَيْبِ ۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ ۝25","s":1.158}]],[56,27,541,[{"l":4,"t":" وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَٰهِيمَ","s":1.158},{"l":5,"t":"وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ ۖ فَمِنْهُم مُّهْتَدٍ ۖ","s":1.396},{"l":6,"t":"وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ ۝26","s":1.448}]],[56,28,541,[{"l":6,"t":" ثُمَّ قَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم","s":1.448},{"l":7,"t":"بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ٱبْنِ مَرْيَمَ وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ","s":1.417},{"l":8,"t":"وَجَعَلْنَا فِى قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً","s":1.3},{"l":9,"t":"ٱبْتَدَعُوهَا مَا كَتَبْنَـٰهَا عَلَيْهِمْ إِلَّا ٱبْتِغَآءَ رِضْوَٰنِ ٱللَّهِ فَمَا","s":1.302},{"l":10,"t":"رَعَوْهَا حَقَّ رِعَايَتِهَا ۖ فَـَٔاتَيْنَا ٱلَّذِينَ ءَامَنُوا۟ مِنْهُمْ أَجْرَهُمْ ۖ","s":1.255},{"l":11,"t":"وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ ۝27","s":1.267}]],[56,29,541,[{"l":11,"t":" يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ","s":1.267},{"l":12,"t":"وَءَامِنُوا۟ بِرَسُولِهِۦ يُؤْتِكُمْ كِفْلَيْنِ مِن رَّحْمَتِهِۦ وَيَجْعَل لَّكُمْ","s":1.213},{"l":13,"t":"نُورًا تَمْشُونَ بِهِۦ وَيَغْفِرْ لَكُمْ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ۝28","s":1.11}]],[56,30,541,[{"l":13,"t":" لِّئَلَّا يَعْلَمَ","s":1.11},{"l":14,"t":"أَهْلُ ٱلْكِتَـٰبِ أَلَّا يَقْدِرُونَ عَلَىٰ شَىْءٍ مِّن فَضْلِ ٱللَّهِ ۙ وَأَنَّ","s":1.173},{"l":15,"t":"ٱلْفَضْلَ بِيَدِ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ۝29","s":-1}]]]}