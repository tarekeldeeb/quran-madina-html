524,[{"l":8,"t":" يَتَنَـٰزَعُونَ","s":1.091},{"l":9,"t":"فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ ۝23","s":1.118}]],[51,25,524,[{"l":9,"t":" ۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ","s":1.118},{"l":10,"t":"لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَّكْنُونٌ ۝24","s":1.057}]],[51,26,524,[{"l":10,"t":" وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","s":1.057},{"l":11,"t":"۝25","s":1.299}]],[51,27,524,[{"l":11,"t":" قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ ۝26","s":1.299}]],[51,28,524,[{"l":11,"t":" فَمَنَّ ٱللَّهُ","s":1.299},{"l":12,"t":"عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ ۝27","s":1.41}]],[51,29,524,[{"l":12,"t":" إِنَّا كُنَّا مِن قَبْلُ","s":1.41},{"l":13,"t":"نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ ۝28","s":1.267}]],[51,30,524,[{"l":13,"t":" فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ","s":1.267},{"l":14,"t":"رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ ۝29","s":1.053}]],[51,31,524,[{"l":14,"t":" أَمْ يَقُولُونَ شَاعِرٌ نَّتَرَبَّصُ بِهِۦ رَيْبَ","s":1.053},{"l":15,"t":"ٱلْمَنُونِ ۝30","s":1.224}]],[51,32,524,[{"l":15,"t":" قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ ۝31","s":1.224}]],[51,33,525,[{"l":1,"t":"أَمْ تَأْمُرُهُمْ أَحْلَـٰمُهُم بِهَـٰذَآ ۚ أَمْ هُمْ قَوْمٌ طَاغُونَ ۝32","s":0.952}]],[51,34,525,[{"l":1,"t":" أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ","s":0.952},{"l":2,"t":"بَل لَّا يُؤْمِنُونَ ۝33","s":1.156}]],[51,35,525,[{"l":2,"t":" فَلْيَأْتُوا۟ بِحَدِيثٍ مِّثْلِهِۦٓ إِن كَانُوا۟ صَـٰدِقِينَ","s":1.156},{"l":3,"t":"۝34","s":1.139}]],[51,36,525,[{"l":3,"t":" أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَـٰلِقُونَ ۝35","s":1.139}]],[51,37,525,[{"l":3,"t":" أَمْ خَلَقُوا۟","s":1.139},{"l":4,"t":"ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ ۝36","s":1.155}]],[51,38,525,[{"l":4,"t":" أَمْ عِندَهُمْ خَزَآئِنُ","s":1.155},{"l":5,"t":"رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ ۝37","s":1.04}]],[51,39,525,[{"l":5,"t":" أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ","s":1.04},{"l":6,"t":"مُسْتَمِعُهُم بِسُلْطَـٰنٍ مُّبِينٍ ۝38","s":1.106}]],[51,40,525,[{"l":6,"t":" أَمْ لَهُ ٱلْبَنَـٰتُ وَلَكُمُ ٱلْبَنُونَ ۝39","s":1.106}]],[51,41,525,[{"l":7,"t":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ ۝40","s":1.009}]],[51,42,525,[{"l":7,"t":" أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ","s":1.009},{"l":8,"t":"يَكْتُبُونَ ۝41","s":1.019}]],[51,43,525,[{"l":8,"t":" أَمْ يُرِيدُونَ كَيْدًا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ ۝42","s":1.019}]],[51,44,525,[{"l":9,"t":"أَمْ لَهُمْ إِلَـٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَـٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ ۝43","s":1.007}]],[51,45,525,[{"l":9,"t":" وَإِن يَرَوْا۟ كِسْفًا","s":1.007},{"l":10,"t":"مِّنَ ٱلسَّمَآءِ سَاقِطًا يَقُولُوا۟ سَحَابٌ مَّرْكُومٌ ۝44","s":1.052}]],[51,46,525,[{"l":10,"t":" فَذَرْهُمْ حَتَّىٰ يُلَـٰقُوا۟","s":1.052},{"l":11,"t":"يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ ۝45","s":1.092}]],[51,47,525,[{"l":11,"t":" يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًٔا","s":1.092},{"l":12,"t":"وَلَا هُمْ يُنصَرُونَ ۝46","s":1.057}]],[51,48,525,[{"l":12,"t":" وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًا دُونَ ذَٰلِكَ وَلَـٰكِنَّ","s":1.057},{"l":13,"t":"أَكْثَرَهُمْ لَا يَعْلَمُونَ ۝47","s":1.062}]],[51,49,525,[{"l":13,"t":" وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ","s":1.062},{"l":14,"t":"بِحَمْدِ رَبِّكَ حِينَ تَقُومُ ۝48","s":-1}]],[51,50,525,[{"l":14,"t":" وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَـٰرَ ٱلنُّجُومِ ۝49","s":-1}]],[52,0,525,[{"l":15,"t":"سورة النجم","s":-1}]],[52,1,526,[{"l":1,"t":"﷽","s":-1}]],[52,2,526,[{"l":2,"t":"وَٱلنَّجْمِ إِذَا هَوَىٰ ۝1","s":1.023}]],[52,3,526,[{"l":2,"t":" مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ ۝2","s":1.023}]],[52,4,526,[{"l":2,"t":" وَمَا يَنطِقُ","s":1.023},{"l":3,"t":"عَنِ ٱلْهَوَىٰٓ ۝3","s":1.0}]],[52,5,526,[{"l":3,"t":" إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ ۝4","s":1.0}]],[52,6,526,[{"l":3,"t":" عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ ۝5","s":1.0}]],[52,7,526,[{"l":4,"t":"ذُو مِرَّةٍ فَٱسْتَوَىٰ ۝6","s":1.03}]],[52,8,526,[{"l":4,"t":" وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ ۝7","s":1.03}]],[52,9,526,[{"l":4,"t":" ثُمَّ دَنَا فَتَدَلَّىٰ ۝8","s":1.03}]],[52,10,526,[{"l":5,"t":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ ۝9","s":1.013}]],[52,11,526,[{"l":5,"t":" فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ ۝10","s":1.013}]],[52,12,526,[{"l":6,"t":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ ۝11","s":0.979}]],[52,13,526,[{"l":6,"t":" أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ ۝12","s":0.979}]],[52,14,526,[{"l":6,"t":" وَلَقَدْ رَءَاهُ","s":0.979},{"l":7,"t":"نَزْلَةً أُخْرَىٰ ۝13","s":1.019}]],[52,15,526,[{"l":7,"t":" عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ ۝14","s":1.019}]],[52,16,526,[{"l":7,"t":" عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ ۝15","s":1.019}]],[52,17,526,[{"l":8,"t":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ ۝16","s":0.967}]],[52,18,526,[{"l":8,"t":" مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ ۝17","s":0.967}]],[52,19,526,[{"l":8,"t":" لَقَدْ رَأَىٰ","s":0.967},{"l":9,"t":"مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ ۝18","s":1.071}]],[52,20,526,[{"l":9,"t":" أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ ۝19","s":1.071}]],[52,21,526,[{"l":9,"t":" وَمَنَوٰةَ","s":1.071},{"l":10,"t":"ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ ۝20","s":1.085}]],[52,22,526,[{"l":10,"t":" أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ ۝21","s":1.085}]],[52,23,526,[{"l":10,"t":" تِلْكَ إِذًا قِسْمَةٌ","s":1.085},{"l":11,"t":"ضِيزَىٰٓ ۝22","s":1.078}]],[52,24,526,[{"l":11,"t":" إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ","s":1.078},{"l":12,"t":"ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ","s":1.084},{"l":13,"t":"وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ ۝23","s":1.044}]],[52,25,526,[{"l":13,"t":" أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ ۝24","s":1.044}]],[52,26,526,[{"l":13,"t":" فَلِلَّهِ","s":1.044},{"l":14,"t":"ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ ۝25","s":1.115}]],[52,27,526,[{"l":14,"t":" ۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى","s":1.115},{"l":15,"t":"شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ ۝26","s":1.046}]],[52,28,527,[{"l":1,"t":"إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ ۝27","s":1.032}]],[52,29,527,[{"l":2,"t":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ","s":1.014},{"l":3,"t":"ٱلْحَقِّ شَيْـًٔا ۝28","s":0.978}]],[52,30,527,[{"l":3,"t":" فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ","s":0.978},{"l":4,"t":"ٱلدُّنْيَا ۝29","s":1.017}]],[52,31,527,[{"l":4,"t":" ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن","s":1.017},{"l":5,"t":"سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ ۝30","s":1.119}]],[52,32,527,[{"l":5,"t":" وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا","s":1.119},{"l":6,"t":"فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟","s":1.042},{"l":7,"t":"بِٱلْحُسْنَى ۝31","s":1.092}]],[52,33,527,[{"l":7,"t":" ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ","s":1.092},{"l":8,"t":"إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ","s":1.073},{"l":9,"t":"وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ","s":1.087},{"l":10,"t":"بِمَنِ ٱتَّقَىٰٓ ۝32","s":1.105}]],[52,34,527,[{"l":10,"t":" أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ ۝33","s":1.105}]],[52,35,527,[{"l":10,"t":" وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ","s":1.105},{"l":11,"t":"۝34","s":1.091}]],[52,36,527,[{"l":11,"t":" أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ ۝35","s":1.091}]],[52,37,527,[{"l":11,"t":" أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ","s":1.091},{"l":12,"t":"مُوسَىٰ ۝36","s":1.106}]],[52,38,527,[{"l":12,"t":" وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ ۝37","s":1.106}]],[52,39,527,[{"l":12,"t":" أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ","s":1.106},{"l":13,"t":"۝38","s":1.13}]],[52,40,527,[{"l":13,"t":" وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ ۝39","s":1.13}]],[52,41,527,[{"l":13,"t":" وَأَنَّ سَعْيَهُۥ سَوْفَ","s":1.13},{"l":14,"t":"يُرَىٰ ۝40","s":1.126}]],[52,42,527,[{"l":14,"t":" ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ ۝41","s":1.126}]],[52,43,527,[{"l":14,"t":" وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ","s":1.126},{"l":15,"t":"۝42","s":1.128}]],[52,44,527,[{"l":15,"t":" وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ ۝43","s":1.128}]],[52,45,527,[{"l":15,"t":" وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا ۝44","s":1.128}]],[52,46,528,[{"l":1,"t":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ ۝45","s":1.01}]],[52,47,528,[{"l":1,"t":" مِن نُّطْفَةٍ إِذَا تُمْنَىٰ ۝46","s":1.01}]],[52,48,528,[{"l":1,"t":" وَأَنَّ","s":1.01},{"l":2,"t":"عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ ۝47","s":1.029}]],[52,49,528,[{"l":2,"t":" وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ ۝48","s":1.029}]],[52,50,528,[{"l":2,"t":" وَأَنَّهُۥ هُوَ رَبُّ","s":1.029},{"l":3,"t":"ٱلشِّعْرَىٰ ۝49","s":1.062}]],[52,51,528,[{"l":3,"t":" وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ ۝50","s":1.062}]],[52,52,528,[{"l":3,"t":" وَثَمُودَا۟ فَمَآ أَبْقَىٰ ۝51","s":1.062}]],[52,53,528,[{"l":4,"t":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ ۝52","s":1.049}]],[52,54,528,[{"l":4,"t":" وَٱلْمُؤْتَفِكَةَ","s":1.049},{"l":5,"t":"أَهْوَىٰ ۝53","s":1.071}]],[52,55,528,[{"l":5,"t":" فَغَشَّىٰهَا مَا غَشَّىٰ ۝54","s":1.071}]],[52,56,528,[{"l":5,"t":" فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ ۝55","s":1.071}]],[52,57,528,[{"l":6,"t":"هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ ۝56","s":1.055}]],[52,58,528,[{"l":6,"t":" أَزِفَتِ ٱلْـَٔازِفَةُ ۝57","s":1.055}]],[52,59,528,[{"l":6,"t":" لَيْسَ لَهَا مِن","s":1.055},{"l":7,"t":"دُونِ ٱللَّهِ كَاشِفَةٌ ۝58","s":1.022}]],[52,60,528,[{"l":7,"t":" أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ ۝59","s":1.022}]],[52,61,528,[{"l":7,"t":" وَتَضْحَكُونَ","s":1.022},{"l":8,"t":"وَلَا تَبْكُونَ ۝60","s":-1}]],[52,62,528,[{"l":8,"t":" وَأَنتُمْ سَـٰمِدُونَ ۝61","s":-1}]],[52,63,528,[{"l":8,"t":" فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩ ۝62","s":-1}]],[53,0,528,[{"l":9,"t":"سورة القمر","s":-1}]],[53,1,528,[{"l":10,"t":"﷽","s":-1}]],[53,2,528,[{"l":11,"t":"ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ ۝1","s":1.227}]],[53,3,528,[{"l":11,"t":" وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟","s":1.227},{"l":12,"t":"وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ ۝2","s":1.342}]],[53,4,528,[{"l":12,"t":" وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ","s":1.342},{"l":13,"t":"وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ ۝3","s":1.43}]],[53,5,528,[{"l":13,"t":" وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ","s":1.43},{"l":14,"t":"مَا فِيهِ مُزْدَجَرٌ ۝4","s":1.456}]],[53,6,528,[{"l":14,"t":" حِكْمَةٌۢ بَـٰلِغَةٌ ۖ فَمَا تُغْنِ ٱلنُّذُرُ","s":1.456},{"l":15,"t":"۝5","s":1.339}]],[53,7,528,[{"l":15,"t":" فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ ۝6","s":1.339}]],[53,8,529,[{"l":1,"t":"خُشَّعًا أَبْصَـٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌ مُّنتَشِرٌ ۝7","s":1.021}]],[53,9,529,[{"l":2,"t":"مُّهْطِعِينَ إِلَى ٱلدَّاعِ ۖ يَقُولُ ٱلْكَـٰفِرُونَ هَـٰذَا يَوْمٌ عَسِرٌ ۝8","s":1.009}]],[53,10,529,[{"l":2,"t":" ۞ كَذَّبَتْ","s":1.009},{"l":3,"t":"قَبْلَهُمْ قَوْمُ نُوحٍ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌ وَٱزْدُجِرَ ۝9","s":1.11}]],[53,11,529,[{"l":3,"t":" فَدَعَا","s":1.11},{"l":4,"t":"رَبَّهُۥٓ أَنِّى مَغْلُوبٌ فَٱنتَصِرْ ۝10","s":1.067}]],[53,12,529,[{"l":4,"t":" فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍ مُّنْهَمِرٍ","s":1.067},{"l":5,"t":"۝11","s":1.083}]],[53,13,529,[{"l":5,"t":" وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍ قَدْ قُدِرَ ۝12","s":1.083}]],[53,14,529,[{"l":6,"t":"وَحَمَلْنَـٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍ وَدُسُرٍ ۝13","s":1.029}]],[53,15,529,[{"l":6,"t":" تَجْرِى بِأَعْيُنِنَا جَزَآءً لِّمَن كَانَ","s":1.029},{"l":7,"t":"كُفِرَ ۝14","s":1.095}]],[53,16,529,[{"l":7,"t":" وَلَقَد تَّرَكْنَـٰهَآ ءَايَةً فَهَلْ مِن مُّدَّكِرٍ ۝15","s":1.095}]],[53,17,529,[{"l":7,"t":" فَكَيْفَ كَانَ","s":1.095},{"l":8,"t":"عَذَابِى وَنُذُرِ ۝16","s":1.177}]],[53,18,529,[{"l":8,"t":" وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ","s":1.177},{"l":9,"t":"۝17","s":1.061}]],[53,19,529,[{"l":9,"t":" كَذَّبَتْ عَادٌ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ ۝18","s":1.061}]],[53,20,529,[{"l":9,"t":" إِنَّآ أَرْسَلْنَا عَلَيْهِمْ","s":1.061},{"l":10,"t":"رِيحًا صَرْصَرًا فِى يَوْمِ نَحْسٍ مُّسْتَمِرٍّ ۝19","s":1.04}]],[53,21,529,[{"l":10,"t":" تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ","s":1.04},{"l":11,"t":"نَخْلٍ مُّنقَعِرٍ ۝20","s":1.016}]],[53,22,529,[{"l":11,"t":" فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ ۝21","s":1.016}]],[53,23,529,[{"l":11,"t":" وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","s":1.016},{"l":12,"t":"لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ ۝22","s":1.102}]],[53,24,529,[{"l":12,"t":" كَذَّبَتْ ثَمُودُ بِٱلنُّذُرِ ۝23","s":1.102}]],[53,25,529,[{"l":12,"t":" فَقَالُوٓا۟ أَبَشَرًا","s":1.102},{"l":13,"t":"مِّنَّا وَٰحِدًا نَّتَّبِعُهُۥٓ إِنَّآ إِذًا لَّفِى ضَلَـٰلٍ وَسُعُرٍ ۝24","s":1.071}]],[53,26,529,[{"l":13,"t":" أَءُلْقِىَ ٱلذِّكْرُ عَلَيْهِ","s":1.071},{"l":14,"t":"مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌ ۝25","s":1.111}]],[53,27,529,[{"l":14,"t":" سَيَعْلَمُونَ غَدًا مَّنِ ٱلْكَذَّابُ","s":1.111},{"l":15,"t":"ٱلْأَشِرُ ۝26","s":1.11}]],[53,28,529,[{"l":15,"t":" إِنَّا مُرْسِلُوا۟ ٱلنَّاقَةِ فِتْنَةً لَّهُمْ فَٱرْتَقِبْهُمْ وَٱصْطَبِرْ ۝27","s":1.11}]],[53,29,530,[{"l":1,"t":"وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ شِرْبٍ مُّحْتَضَرٌ ۝28","s":0.978}]],[53,30,530,[{"l":1,"t":" فَنَادَوْا۟ صَاحِبَهُمْ","s":0.978},{"l":2,"t":"فَتَعَاطَىٰ فَعَقَرَ ۝29","s":1.034}]],[53,31,530,[{"l":2,"t":" فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ ۝30","s":1.034}]],[53,32,530,[{"l":2,"t":" إِنَّآ أَرْسَلْنَا عَلَيْهِمْ","s":1.034},{"l":3,"t":"صَيْحَةً وَٰحِدَةً فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ ۝31","s":1.12}]],[53,33,530,[{"l":3,"t":" وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","s":1.12},{"l":4,"t":"لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ ۝32","s":1.046}]],[53,34,530,[{"l":4,"t":" كَذَّبَتْ قَوْمُ لُوطٍۭ بِٱلنُّذُرِ ۝33","s":1.046}]],[53,35,530,[{"l":4,"t":" إِنَّآ أَرْسَلْنَا","s":1.046},{"l":5,"t":"عَلَيْهِمْ حَاصِبًا إِلَّآ ءَالَ لُوطٍ ۖ نَّجَّيْنَـٰهُم بِسَحَرٍ ۝34","s":1.042}]],[53,36,530,[{"l