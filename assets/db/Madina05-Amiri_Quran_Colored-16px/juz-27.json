{"j":26,"d":[[50,32,522,[{"l":1,"t":"۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ ۝31","s":1.064}]],[50,33,522,[{"l":1,"t":" قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ","s":1.064},{"l":2,"t":"مُّجْرِمِينَ ۝32","s":1.049}]],[50,34,522,[{"l":2,"t":" لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِّن طِينٍ ۝33","s":1.049}]],[50,35,522,[{"l":2,"t":" مُّسَوَّمَةً عِندَ رَبِّكَ","s":1.049},{"l":3,"t":"لِلْمُسْرِفِينَ ۝34","s":1.016}]],[50,36,522,[{"l":3,"t":" فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ ۝35","s":1.016}]],[50,37,522,[{"l":3,"t":" فَمَا وَجَدْنَا","s":1.016},{"l":4,"t":"فِيهَا غَيْرَ بَيْتٍ مِّنَ ٱلْمُسْلِمِينَ ۝36","s":1.108}]],[50,38,522,[{"l":4,"t":" وَتَرَكْنَا فِيهَآ ءَايَةً لِّلَّذِينَ يَخَافُونَ","s":1.108},{"l":5,"t":"ٱلْعَذَابَ ٱلْأَلِيمَ ۝37","s":1.082}]],[50,39,522,[{"l":5,"t":" وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَـٰنٍ","s":1.082},{"l":6,"t":"مُّبِينٍ ۝38","s":0.964}]],[50,40,522,[{"l":6,"t":" فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ أَوْ مَجْنُونٌ ۝39","s":0.964}]],[50,41,522,[{"l":6,"t":" فَأَخَذْنَـٰهُ وَجُنُودَهُۥ","s":0.964},{"l":7,"t":"فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌ ۝40","s":1.099}]],[50,42,522,[{"l":7,"t":" وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ","s":1.099},{"l":8,"t":"ٱلْعَقِيمَ ۝41","s":1.095}]],[50,43,522,[{"l":8,"t":" مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ ۝42","s":1.095}]],[50,44,522,[{"l":9,"t":"وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍ ۝43","s":1.061}]],[50,45,522,[{"l":9,"t":" فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ","s":1.061},{"l":10,"t":"فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ ۝44","s":1.119}]],[50,46,522,[{"l":10,"t":" فَمَا ٱسْتَطَـٰعُوا۟ مِن قِيَامٍ","s":1.119},{"l":11,"t":"وَمَا كَانُوا۟ مُنتَصِرِينَ ۝45","s":1.106}]],[50,47,522,[{"l":11,"t":" وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًا","s":1.106},{"l":12,"t":"فَـٰسِقِينَ ۝46","s":1.045}]],[50,48,522,[{"l":12,"t":" وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوس