{"j":26,"d":[[50,32,522,[{"l":1,"t":"۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا الْمُرْسَلُونَ ﴿٣١﴾","s":0.87}]],[50,33,522,[{"l":1,"t":" قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ","s":0.87},{"l":2,"t":"مُّجْرِمِينَ ﴿٣٢﴾","s":0.802}]],[50,34,522,[{"l":2,"t":" لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِّن طِينٍ ﴿٣٣﴾","s":0.802}]],[50,35,522,[{"l":2,"t":" مُّسَوَّمَةً عِندَ رَبِّكَ","s":0.802},{"l":3,"t":"لِلْمُسْرِفِينَ ﴿٣٤﴾","s":0.801}]],[50,36,522,[{"l":3,"t":" فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ الْمُؤْمِنِينَ ﴿٣٥﴾","s":0.801}]],[50,37,522,[{"l":3,"t":" فَمَا وَجَدْنَا","s":0.801},{"l":4,"t":"فِيهَا غَيْرَ بَيْتٍ مِّنَ الْمُسْلِمِينَ ﴿٣٦﴾","s":0.852}]],[50,38,522,[{"l":4,"t":" وَتَرَكْنَا فِيهَآ ءَايَةً لِّلَّذِينَ يَخَافُونَ","s":0.852},{"l":5,"t":"الْعَذَابَ الْأَلِيمَ ﴿٣٧﴾","s":0.894}]],[50,39,522,[{"l":5,"t":" وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَـٰنٍ","s":0.894},{"l":6,"t":"مُّبِينٍ ﴿٣٨﴾","s":0.775}]],[50,40,522,[{"l":6,"t":" فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ أَوْ مَجْنُونٌ ﴿٣٩﴾","s":0.775}]],[50,41,522,[{"l":6,"t":" فَأَخَذْنَـٰهُ وَجُنُودَهُۥ","s":0.775},{"l":7,"t":"فَنَبَذْنَـٰهُمْ فِى الْيَمِّ وَهُوَ مُلِيمٌ ﴿٤٠﴾","s":0.886}]],[50,42,522,[{"l":7,"t":" وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ الرِّيحَ","s":0.886},{"l":8,"t":"الْعَقِيمَ ﴿٤١﴾","s":0.854}]],[50,43,522,[{"l":8,"t":" مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِ ﴿٤٢﴾","s":0.854}]],[50,44,522,[{"l":9,"t":"وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍ ﴿٤٣﴾","s":0.877}]],[50,45,522,[{"l":9,"t":" فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ","s":0.877},{"l":10,"t":"فَأَخَذَتْهُمُ الصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ ﴿٤٤﴾","s":0.921}]],[50,46,522,[{"l":10,"t":" فَمَا اسْتَطَـٰعُوا۟ مِن قِيَامٍ","s":0.921},{"l":11,"t":"وَمَا كَانُوا۟ مُنتَصِرِينَ ﴿٤٥﴾","s":0.943}]],[50,47,522,[{"l":11,"t":" وَقَوْمَ نُوحٍ مِّن قَبْلُۖ إِنَّهُمْ كَانُوا۟ قَوْمًا","s":0.943},{"l":12,"t":"فَـٰسِقِينَ ﴿٤٦﴾","s":0.844}]],[50,48,522,[{"l":12,"t":" وَالسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَ