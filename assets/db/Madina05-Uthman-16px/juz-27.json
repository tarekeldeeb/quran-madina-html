],[56,19,539,[{"l":14,"t":" إِنَّ الْمُصَّدِّقِينَ وَالْمُصَّدِّقَـٰتِ وَأَقْرَضُوا۟","s":0.945},{"l":15,"t":"اللَّـهَ قَرْضًا حَسَنًـا يُضَـٰعَفُ لَهُـمْ وَلَهُمْ أَجْـرٌ كَرِيمٌ ﴿١٨﴾","s":0.995}]],[56,20,540,[{"l":1,"t":"وَالَّذِينَ ءَامَنُوا۟ بِاللَّهِ وَرُسُلِهِۦٓ أُو۟لَـٰٓئِكَ هُمُ الصِّدِّيقُونَۖ وَالشُّهَدَآءُ","s":0.971},{"l":2,"t":"عِنـدَ رَبِّهِمْ لَهُـمْ أَجْرُهُمْ وَنُورُهُـمْۖ وَالَّذِينَ كَفَـرُوا۟ وَكَذَّبُوا۟","s":1.027},{"l":3,"t":"بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ الْجَحِيمِ ﴿١٩﴾","s":0.963}]],[56,21,540,[{"l":3,"t":" اعْلَمُوٓا۟ أَنَّمَا الْحَيَوٰةُ","s":0.963},{"l":4,"t":"الدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌ فِى الْأَمْوَٰلِ","s":0.975},{"l":5,"t":"وَالْأَوْلَـٰدِۖ كَمَثَلِ غَيْثٍ أَعْجَبَ الْكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ","s":0.987},{"l":6,"t":"مُصْفَرًّا ثُمَّ يَكُونُ حُطَـٰمًاۖ وَفِى الْـَٔاخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ","s":0.948},{"l":7,"t":"مِّـنَ اللَّهِ وَرِضْوَٰنٌۚ وَمَا الْحَيَـوٰةُ الدُّنْيَآ إِلَّا مَتَـٰعُ الْغُرُورِ ﴿٢٠﴾","s":0.982}]],[56,22,540,[{"l":8,"t":"سَابِقُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَآءِ","s":0.98},{"l":9,"t":"وَالْأَرْضِ أُعِـدَّتْ لِلَّذِيـنَ ءَامَنُوا۟ بِاللَّـهِ وَرُسُلِهِۦۚ ذَٰلِـكَ فَضْلُ","s":0.981},{"l":10,"t":"اللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ ﴿٢١﴾","s":0.951}]],[56,23,540,[{"l":10,"t":" مَآ أَصَابَ","s":0.951},{"l":11,"t":"مِـن مُّصِيبَـةٍ فِـى الْأَرْضِ وَلَا فِىٓ أَنفُسِكُـمْ إِلَّا فِـى كِتَـٰبٍ","s":0.99},{"l":12,"t":"مِّـن قَبْلِ أَن نَّبْرَأَهَـآۚ إِنَّ ذَٰلِكَ عَلَـى اللَّهِ يَسِيـرٌ ﴿٢٢﴾","s":0.955}]],[56,24,540,[{"l":12,"t":" لِّكَيْلَا","s":0.955},{"l":13,"t":"تَأْسَـوْا۟ عَلَـىٰ مَـا فَاتَكُمْ وَلَا تَفْرَحُـوا۟ بِمَـآ ءَاتَىٰكُـمْۗ وَاللَّهُ","s":0.994},{"l":14,"t":"لَا يُحِـبُّ كُلَّ مُخْتَالٍ فَخُـورٍ ﴿٢٣﴾","s":0.997}]],[56,25,540,[{"l":14,"t":" الَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ","s":0.997},{"l":15,"t":"النَّاسَ بِالْبُخْلِۗ وَمَن يَتَوَلَّ فَإِنَّ اللَّهَ هُوَ الْغَنِىُّ الْحَمِيدُ ﴿٢٤﴾","s":0.994}]],[56,26,541,[{"l":1,"t":"لَقَــدْ أَرْسَلْنَـا رُسُلَنَـا بِالْبَيِّـنَـٰتِ وَأَنزَلْنَـا مَعَهُـمُ الْكِـتَـٰبَ","s":0.988},{"l":2,"t":"وَالْمِيــزَانَ لِيَقُـومَ النَّـاسُ بِالْقِسْـطِۖ وَأَنزَلْنَـا الْحَدِيـدَ فِيـهِ","s":0.981},{"l":3,"t":"بَأْسٌ شَدِيدٌ وَمَنَـٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ اللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ","s":0.998},{"l":4,"t":"بِالْغَيْبِۚ إِنَّ اللَّهَ قَوِىٌّ عَزِيزٌ ﴿٢٥﴾","s":0.963}]],[56,27,541,[{"l":4,"t":" وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَٰهِيمَ","s":0.963},{"l":5,"t":"وَجَعَلْنَــا فِـى ذُرِّيَّتِهِمَــا النُّبُـوَّةَ وَالْكِــتَـٰبَۖ فَمِنْهُـم مُّهْتَـدٍۖ","s":0.967},{"l":6,"t":"وَكَثِيــرٌ مِّنْهُـمْ فَـٰسِقُـونَ ﴿٢٦﴾","s":0.962}]],[56,28,541,[{"l":6,"t":" ثُـمَّ قَفَّيْنَـا عَلَـىٰٓ ءَاثَـٰرِهِـم","s":0.962},{"l":7,"t":"بِرُسُلِنَــا وَقَفَّيْنَـا بِعِيسَـى ابْــنِ مَرْيَـمَ وَءَاتَيْـنَـٰهُ الْإِنجِيـلَ","s":0.981},{"l":8,"t":"وَجَعَلْنَـا فِـى قُلُـوبِ الَّذِيـنَ اتَّبَعُـوهُ رَأْفَـةً وَرَحْمَـةً وَرَهْبَانِيَّةً","s":0.976},{"l":9,"t":"ابْتَدَعُوهَـا مَا كَتَبْنَـٰهَـا عَلَيْهِمْ إِلَّا ابْتِغَـآءَ رِضْوَٰنِ اللَّـهِ فَمَا","s":0.986},{"l":10,"t":"رَعَوْهَـا حَـقَّ رِعَايَتِهَاۖ فَـَٔاتَيْنَـا الَّذِيـنَ ءَامَنُوا۟ مِنْهُـمْ أَجْرَهُمْۖ","s":1.0},{"l":11,"t":"وَكَثِيـرٌ مِّنْهُمْ فَـٰسِقُونَ ﴿٢٧﴾","s":0.982}]],[56,29,541,[{"l":11,"t":" يَـٰٓأَيُّهَا الَّذِينَ ءَامَنُوا۟ اتَّقُوا۟ اللَّهَ","s":0.982},{"l":12,"t":"وَءَامِنُـوا۟ بِرَسُولِهِۦ يُؤْتِكُمْ كِفْلَيْنِ مِن رَّحْمَتِهِۦ وَيَجْعَل لَّكُمْ","s":0.987},{"l":13,"t":"نُورًا تَمْشُونَ بِهِۦ وَيَغْفِرْ لَكُمْۚ وَاللَّهُ غَفُورٌ رَّحِيمٌ ﴿٢٨﴾","s":0.903}]],[56,30,541,[{"l":13,"t":" لِّئَلَّا يَعْلَمَ","s":0.903},{"l":14,"t":"أَهْـلُ الْكِتَـٰبِ أَلَّا يَقْـدِرُونَ عَلَىٰ شَـىْءٍ مِّن فَضْـلِ اللَّهِۙ وَأَنَّ","s":0.982},{"l":15,"t":"الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ ﴿٢٩﴾","s":0.916}]]]}