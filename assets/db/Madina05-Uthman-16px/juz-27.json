15,"t":"شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ اللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ ﴿٢٦﴾","s":0.886}]],[52,28,527,[{"l":1,"t":"إِنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْـَٔاخِرَةِ لَيُسَمُّونَ الْمَلَـٰٓئِكَةَ تَسْمِيَةَ الْأُنثَىٰ ﴿٢٧﴾","s":0.834}]],[52,29,527,[{"l":2,"t":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ إِن يَتَّبِعُونَ إِلَّا الظَّنَّۖ وَإِنَّ الظَّنَّ لَا يُغْنِى مِنَ","s":0.926},{"l":3,"t":"الْحَقِّ شَيْـًٔا ﴿٢٨﴾","s":0.844}]],[52,30,527,[{"l":3,"t":" فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَوٰةَ","s":0.844},{"l":4,"t":"الدُّنْيَا ﴿٢٩﴾","s":0.848}]],[52,31,527,[{"l":4,"t":" ذَٰلِكَ مَبْلَغُهُم مِّنَ الْعِلْمِۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن","s":0.848},{"l":5,"t":"سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَىٰ ﴿٣٠﴾","s":0.929}]],[52,32,527,[{"l":5,"t":" وَلِلَّهِ مَا فِى السَّمَـٰوَٰتِ وَمَا","s":0.929},{"l":6,"t":"فِى الْأَرْضِ لِيَجْزِىَ الَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ الَّذِينَ أَحْسَنُوا۟","s":0.897},{"l":7,"t":"بِالْحُسْنَى ﴿٣١﴾","s":0.915}]],[52,33,527,[{"l":7,"t":" الَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ الْإِثْمِ وَالْفَوَٰحِشَ إِلَّا اللَّمَمَۚ","s":0.915},{"l":8,"t":"إِنَّ رَبَّكَ وَٰسِعُ الْمَغْفِرَةِۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ الْأَرْضِ","s":0.97},{"l":9,"t":"وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْۖ هُوَ أَعْلَمُ","s":0.903},{"l":10,"t":"بِمَنِ اتَّقَىٰٓ ﴿٣٢﴾","s":0.88}]],[52,34,527,[{"l":10,"t":" أَفَرَءَيْتَ الَّذِى تَوَلَّىٰ ﴿٣٣﴾","s":0.88}]],[52,35,527,[{"l":10,"t":" وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ","s":0.88},{"l":11,"t":"﴿٣٤﴾","s":0.852}]],[52,36,527,[{"l":11,"t":" أَعِندَهُۥ عِلْمُ الْغَيْبِ فَهُوَ يَرَىٰٓ ﴿٣٥﴾","s":0.852}]],[52,37,527,[{"l":11,"t":" أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ","s":0.852},{"l":12,"t":"مُوسَىٰ ﴿٣٦﴾","s":0.892}]],[52,38,527,[{"l":12,"t":" وَإِبْرَٰهِيمَ الَّذِى وَفَّىٰٓ ﴿٣٧﴾","s":0.892}]],[52,39,527,[{"l":12,"t":" أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ","s":0.892},{"l":13,"t":"﴿٣٨﴾","s":0.915}]],[52,40,527,[{"l":13,"t":" وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ ﴿٣٩﴾","s":0.915}]],[52,41,527,[{"l":13,"t":" وَأَنَّ سَعْيَهُۥ سَوْفَ","s":0.915},{"l":14,"t":"يُرَىٰ ﴿٤٠﴾","s":0.919}]],[52,42,527,[{"l":14,"t":" ثُمَّ يُجْزَىٰهُ الْجَزَآءَ الْأَوْفَىٰ ﴿٤١﴾","s":0.919}]],[52,43,527,[{"l":14,"t":" وَأَنَّ إِلَىٰ رَبِّكَ الْمُنتَهَىٰ","s":0.919},{"l":15,"t":"﴿٤٢﴾","s":0.831}]],[52,44,527,[{"l":15,"t":" وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ ﴿٤٣﴾","s":0.831}]],[52,45,527,[{"l":15,"t":" وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا ﴿٤٤﴾","s":0.831}]],[52,46,528,[{"l":1,"t":"وَأَنَّهُۥ خَلَقَ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنثَىٰ ﴿٤٥﴾","s":0.802}]],[52,47,528,[{"l":1,"t":" مِن نُّطْفَةٍ إِذَا تُمْنَىٰ ﴿٤٦﴾","s":0.802}]],[52,48,528,[{"l":1,"t":" وَأَنَّ","s":0.802},{"l":2,"t":"عَلَيْهِ النَّشْأَةَ الْأُخْرَىٰ ﴿٤٧﴾","s":0.818}]],[52,49,528,[{"l":2,"t":" وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ ﴿٤٨﴾","s":0.818}]],[52,50,528,[{"l":2,"t":" وَأَنَّهُۥ هُوَ رَبُّ","s":0.818},{"l":3,"t":"الشِّعْرَىٰ ﴿٤٩﴾","s":0.821}]],[52,51,528,[{"l":3,"t":" وَأَنَّهُۥٓ أَهْلَكَ عَادًا الْأُولَىٰ ﴿٥٠﴾","s":0.821}]],[52,52,528,[{"l":3,"t":" وَثَمُودَا۟ فَمَآ أَبْقَىٰ ﴿٥١﴾","s":0.821}]],[52,53,528,[{"l":4,"t":"وَقَوْمَ نُوحٍ مِّن قَبْلُۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ ﴿٥٢﴾","s":0.901}]],[52,54,528,[{"l":4,"t":" وَالْمُؤْتَفِكَةَ","s":0.901},{"l":5,"t":"أَهْوَىٰ ﴿٥٣﴾","s":0.819}]],[52,55,528,[{"l":5,"t":" فَغَشَّىٰهَا مَا غَشَّىٰ ﴿٥٤﴾","s":0.819}]],[52,56,528,[{"l":5,"t":" فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ ﴿٥٥﴾","s":0.819}]],[52,57,528,[{"l":6,"t":"هَـٰذَا نَذِيرٌ مِّنَ النُّذُرِ الْأُولَىٰٓ ﴿٥٦﴾","s":0.833}]],[52,58,528,[{"l":6,"t":" أَزِفَتِ الْـَٔازِفَةُ ﴿٥٧﴾","s":0.833}]],[52,59,528,[{"l":6,"t":" لَيْسَ لَهَا مِن","s":0.833},{"l":7,"t":"دُونِ اللَّهِ كَاشِفَةٌ ﴿٥٨﴾","s":0.8}]],[52,60,528,[{"l":7,"t":" أَفَمِنْ هَـٰذَا الْحَدِيثِ تَعْجَبُونَ ﴿٥٩﴾","s":0.8}]],[52,61,528,[{"l":7,"t":" وَتَضْحَكُونَ","s":0.8},{"l":8,"t":"وَلَا تَبْكُونَ ﴿٦٠﴾","s":0.774}]],[52,62,528,[{"l":8,"t":" وَأَنتُمْ