َمَـٰوَٰتِ وَالْأَرْضِۖ يُحْىِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ﴿٢﴾","s":0.948}]],[56,4,537,[{"l":15,"t":"هُوَ الْأَوَّلُ وَالْـَٔاخِرُ وَالظَّـٰهِرُ وَالْبَاطِنُۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ ﴿٣﴾","s":0.889}]],[56,5,538,[{"l":1,"t":"هُـوَ الَّذِى خَلَقَ السَّمَـٰوَٰتِ وَالْأَرْضَ فِـى سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ","s":0.973},{"l":2,"t":"عَلَى الْعَرْشِۚ يَعْلَمُ مَا يَلِجُ فِى الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنزِلُ مِنَ","s":0.905},{"l":3,"t":"السَّمَآءِ وَمَا يَعْرُجُ فِيهَاۖ وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْۚ وَاللَّهُ بِمَا تَعْمَلُونَ","s":0.872},{"l":4,"t":"بَصِيرٌ ﴿٤﴾","s":0.944}]],[56,6,538,[{"l":4,"t":" لَّهُۥ مُلْكُ السَّمَـٰوَٰتِ وَالْأَرْضِۚ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","s":0.944},{"l":5,"t":"﴿٥﴾","s":0.914}]],[56,7,538,[{"l":5,"t":" يُولِجُ الَّيْلَ فِى النَّهَارِ وَيُولِجُ النَّهَارَ فِى الَّيْلِۚ وَهُوَ عَلِيمٌۢ بِذَاتِ","s":0.914},{"l":6,"t":"الصُّـدُورِ ﴿٦﴾","s":0.983}]],[56,8,538,[{"l":6,"t":" ءَامِنُوا۟ بِاللَّهِ وَرَسُولِـهِۦ وَأَنفِقُوا۟ مِمَّا جَعَلَكُم","s":0.983},{"l":7,"t":"مُّسْتَخْلَفِينَ فِيهِۖ فَالَّذِينَ ءَامَنُوا۟ مِنكُمْ وَأَنفَقُوا۟ لَهُمْ أَجْرٌ كَبِيرٌ ﴿٧﴾","s":0.872}]],[56,9,538,[{"l":8,"t":"وَمَا لَكُمْ لَا تُؤْمِنُونَ بِاللَّهِۙ وَالرَّسُولُ يَدْعُوكُمْ لِتُؤْمِنُوا۟ بِرَبِّكُمْ وَقَدْ","s":0.888},{"l":9,"t":"أَخَذَ مِيثَـٰقَكُمْ إِن كُنتُم مُّؤْمِنِينَ ﴿٨﴾","s":0.888}]],[56,10,538,[{"l":9,"t":" هُوَ الَّذِى يُنَزِّلُ عَلَىٰ عَبْدِهِۦٓ","s":0.888},{"l":10,"t":"ءَايَـٰتٍۭ بَيِّنَـٰتٍ لِّيُخْرِجَكُم مِّنَ الظُّلُمَـٰتِ إِلَى النُّورِۚ وَإِنَّ اللَّهَ بِكُمْ","s":0.89},{"l":11,"t":"لَرَءُوفٌ رَّحِيمٌ ﴿٩﴾","s":0.894}]],[56,11,538,[{"l":11,"t":" وَمَا لَكُمْ أَلَّا تُنفِقُوا۟ فِى سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَٰثُ","s":0.894},{"l":12,"t":"السَّمَـٰوَٰتِ وَالْأَرْضِۚ لَا يَسْتَوِى مِنكُم مَّنْ أَنفَقَ مِن قَبْلِ الْفَتْحِ","s":0.942},{"l":13,"t":"وَقَـٰتَلَۚ أُو۟لَـٰٓئِكَ أَعْظَمُ دَرَجَةً مِّنَ الَّذِينَ أَنفَقُوا۟ مِنۢ بَعْدُ وَقَـٰتَلُوا۟ۚ","s":0.946},{"l":14,"t":"وَكُلًّا وَعَدَ اللَّهُ الْحُسْ